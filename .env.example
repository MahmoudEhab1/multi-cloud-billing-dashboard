# Local portfolio/demo mode
DEMO_MODE=true

# Core Flask security
SECRET_KEY=generate-a-long-random-value
AUTH_PASSWORD_HASH=generate-a-password-hash
ADMIN_PASSWORD_HASH=
API_KEY=generate-a-random-api-key
APP_ROOT=.
BILLING_CACHE_TTL_SECONDS=86400
CACHE_FILE=./cache.json

# Provider registry encryption
PROVIDER_ENCRYPTION_KEY=generate-a-fernet-key
PROVIDER_DATABASE=./data/providers.db

# Cloud credentials (leave empty in DEMO_MODE)
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_TENANCY_OCID=
OCI_REGION=us-ashburn-1
OCI_KEY_FILE=./oci_private_key.pem
OCI_COMPARTMENT_OCID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_GROSS_COST_PROVIDER_SLUGS=primaryaws
CLIENT_AWS_NAME=Secondary AWS
CLIENT_AWS_ACCESS_KEY_ID=
CLIENT_AWS_SECRET_ACCESS_KEY=
CLIENT_AWS_DEFAULT_REGION=us-east-1

# Generic collector-backed provider
PORTAL_CACHE_FILE=./portal_cache.json
PORTAL_PUSH_KEY=generate-a-long-random-shared-secret
HETZNER_CACHE_FILE=./hetzner_cache.json
HETZNER_PUSH_KEY=generate-a-long-random-shared-secret

# Telegram (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
SECONDARY_TELEGRAM_GROUP_ID=
SECONDARY_PROVIDER_SLUG=clientaws
SECONDARY_EXCLUDE_FROM_MAIN=true
